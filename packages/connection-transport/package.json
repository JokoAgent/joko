    "@jokoagent/linkspan-core": "*",
    "@jokoagent/linkspan-noise": "*",
    "@jokoagent/linkspan-http": "*",
    "@jokoagent/linkspan-http-connect": "*",
    "@jokoagent/linkspan-iroh": "*",
    "@jokoagent/linkspan-tailcat": "*",
    "@jokoagent/linkspan-webrtc": "*"
