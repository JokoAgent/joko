{
  "expo": {
    "name": "Joko",
    "slug": "joko",
    "scheme": "joko",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.joko.mobile",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.networking.multicast": true
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to a Joko node on your local network.",
        "NSPhotoLibraryUsageDescription": "Allow Joko to show photos you explicitly choose for a task attachment.",
        "PHPhotoLibraryPreventAutomaticLimitedAccessAlert": true,
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "app.joko.mobile",
      "blockedPermissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "./with-joko-photo-library-boundary.cjs",
      "./with-joko-native-brand.cjs",
      "expo-secure-store",
      ["expo-image-picker", {
        "photosPermission": false,
        "cameraPermission": "Allow Joko to use your camera only when you choose Take photo for a task attachment.",
        "microphonePermission": false
      }],
      ["expo-media-library", {
        "photosPermission": "Allow Joko to show photos you explicitly choose for a task attachment.",
        "savePhotosPermission": false,
        "isAccessMediaLocationEnabled": false,
        "preventAutomaticLimitedAccessAlert": true,
        "granularPermissions": []
      }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
