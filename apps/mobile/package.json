{
  "name": "@joko/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@joko/brand-assets": "workspace:*",
    "@joko/contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.17",
    "expo-build-properties": "57.0.15",
    "expo-constants": "57.0.15",
    "expo-crypto": "57.0.2",
    "expo-file-system": "57.0.6",
    "expo-image-manipulator": "57.0.14",
    "expo-image-picker": "57.0.14",
    "expo-secure-store": "57.0.2",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
