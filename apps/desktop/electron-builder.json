{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/v26.15.3/packages/app-builder-lib/scheme.json",
  "appId": "app.joko.desktop",
  "productName": "Joko",
  "electronVersion": "43.6.0",
  "asar": false,
  "compression": "normal",
  "npmRebuild": false,
  "publish": null,
  "artifactName": "Joko-${version}-${os}-${arch}.${ext}",
  "protocols": [
    {
      "name": "Joko task link",
      "schemes": [
        "joko"
      ]
    }
  ],
  "fileAssociations": [
    {
      "ext": "jshare",
      "name": "Joko task package",
      "description": "Portable Joko task package",
      "mimeType": "application/vnd.joko.session",
      "role": "Editor"
    }
  ],
  "directories": {
    "output": "release",
    "buildResources": "../../packages/brand-assets/src"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/web/**/*",
    "!dist/orchestrator-runtime/**",
    "!dist/.orchestrator-runtime-stage-*/**",
    "!dist/.orchestrator-runtime-backup-*/**",
    "!node_modules/@jokoagent/linkspan-iroh/native/**",
    "!**/*.{map,ts,tsx,cts,mts,proto,tsbuildinfo,c,cc,cpp,cxx,h,hh,hpp,hxx,rs,swift,m,mm,java,go,py,pyi,rb,cs,fs,fsx,scala,kt,kts,jsdoc,keep}",
    "!**/{test,tests,__tests__,coverage,fixtures,workspace}/**",
    "!**/*.test.*",
    "!**/WORKSPACE",
    "!**/WORKSPACE/**",
    "!**/{.env,.env.*,*.db,*.db-shm,*.db-wal,*.log}",
    "!node_modules/**/{README,README.*,CHANGELOG,CHANGELOG.*,docs}/**"
  ],
  "extraResources": [
    {
      "from": "resources/app-update.yml",
      "to": "app-update.yml"
    },
    {
      "from": "resources/native-task-status-sounds",
      "to": "native-task-status-sounds",
      "filter": [
        "*.mp3"
      ]
    },
    {
      "from": "dist/native-voice-shortcut",
      "to": "native-voice-shortcut",
      "filter": [
        "manifest.json",
        "joko-macos-key-listener",
        "joko-windows-function-key-listener.exe"
      ]
    },
    {
      "from": "dist/native-system-frontmost-input",
      "to": "native-system-frontmost-input",
      "filter": [
        "manifest.json",
        "joko-windows-frontmost-input.node",
        "joko-macos-frontmost-input.node",
        "joko-linux-frontmost-input.node"
      ]
    },
    {
      "from": "dist/native-hardware",
      "to": "native-hardware",
      "filter": [
        "manifest.json",
        "joko-windows-micro-helper.exe"
      ]
    },
    {
      "from": "dist/native-gamepad",
      "to": "native-gamepad",
      "filter": [
        "manifest.json",
        "joko-macos-gamepad-helper"
      ]
    },
    {
      "from": "dist/native-menu-bar",
      "to": "native-menu-bar",
      "filter": [
        "manifest.json",
        "joko-macos-menu-bar-helper"
      ]
    },
    {
      "from": "dist/native-remote-desktop",
      "to": "native-remote-desktop",
      "filter": [
        "manifest.json",
        "joko-macos-remote-desktop-capture",
        "joko-macos-remote-desktop-input",
        "joko-macos-remote-credentials",
        "JokoRemoteCredentials_JokoRemoteCredentials.bundle/**/*",
        "joko-windows-remote-desktop-input.exe",
        "joko-windows-remote-desktop-host.exe",
        "joko-windows-remote-desktop-host.node",
        "joko-linux-remote-desktop-input",
        "joko-linux-remote-desktop-capture",
        "joko-linux-remote-desktop-clipboard",
        "linux-viewer-display.py",
        "linux-credentials/main.py",
        "linux-credentials/channel.py",
        "linux-credentials/host.py",
        "linux-credentials/storage.py",
        "linux-credentials/platform_linux.py",
        "linux-credentials/requirements.txt",
        "joko-hyprland-privacy.so",
        "joko-hyprland-privacy.json"
      ]
    },
    {
      "from": "dist/orchestrator-runtime",
      "to": "orchestrator-runtime",
      "filter": [
        "**/*",
        "!node_modules/**",
        "!**/*.{map,ts,tsx,cts,mts,proto,tsbuildinfo,c,cc,cpp,cxx,h,hh,hpp,hxx,rs,swift,m,mm,java,go,py,pyi,rb,cs,fs,fsx,scala,kt,kts,jsdoc,keep}",
        "!**/{test,tests,__tests__,coverage,fixtures,workspace}/**",
        "!**/*.test.*",
        "!**/WORKSPACE",
        "!**/WORKSPACE/**",
        "!**/{.env,.env.*,*.db,*.db-shm,*.db-wal,*.log}"
      ]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules",
      "to": "orchestrator-runtime/node_modules",
      "filter": [
        "**/*",
        "!**/*.{map,ts,tsx,cts,mts,proto,tsbuildinfo,c,cc,cpp,cxx,h,hh,hpp,hxx,rs,swift,m,mm,java,go,py,pyi,rb,cs,fs,fsx,scala,kt,kts,jsdoc,keep}",
        "!**/{test,tests,__tests__,coverage,fixtures,workspace}/**",
        "!**/*.test.*",
        "!**/WORKSPACE",
        "!**/WORKSPACE/**",
        "!**/{.env,.env.*,*.db,*.db-shm,*.db-wal,*.log}"
      ]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-core",
      "to": "app/node_modules/@jokoagent/linkspan-core",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-noise",
      "to": "app/node_modules/@jokoagent/linkspan-noise",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-http",
      "to": "app/node_modules/@jokoagent/linkspan-http",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-http-connect",
      "to": "app/node_modules/@jokoagent/linkspan-http-connect",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.txt", "dist/connect-parser-input.json", "dist/source-build.json"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-iroh",
      "to": "app/node_modules/@jokoagent/linkspan-iroh",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-iroh-node",
      "to": "app/node_modules/@jokoagent/linkspan-iroh-node",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-tailcat",
      "to": "app/node_modules/@jokoagent/linkspan-tailcat",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-tailcat-node",
      "to": "app/node_modules/@jokoagent/linkspan-tailcat-node",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-tailcat-runtime",
      "to": "app/node_modules/@jokoagent/linkspan-tailcat-runtime",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-webrtc",
      "to": "app/node_modules/@jokoagent/linkspan-webrtc",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    },
    {
      "from": "dist/orchestrator-runtime/node_modules/@jokoagent/linkspan-webrtc-node",
      "to": "app/node_modules/@jokoagent/linkspan-webrtc-node",
      "filter": ["package.json", "dist/**/*.js", "dist/**/*.mjs", "dist/**/*.cjs", "dist/**/*.txt", "dist/dependency-inventory.json", "dist/upstream-patches.json", "dist/source-build.json", "THIRD_PARTY_NOTICES.*"]
    }
  ],
  "afterPack": "scripts/audit-packaged.cjs",
  "afterSign": "scripts/seal-windows-native-remote-desktop.cjs",
  "win": {
    "icon": "icon-light.svg",
    "forceCodeSigning": false,
    "target": [
      "nsis",
      "zip"
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "selectPerMachineByDefault": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "include": "resources/installer.nsh",
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "icon": "icon-light.svg",
    "hardenedRuntime": true,
    "sign": "scripts/sign-mac-native-credentials.cjs",
    "binaries": ["Contents/Resources/native-remote-desktop/joko-macos-remote-credentials"],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Joko uses the microphone only while you choose to dictate into the composer.",
      "NSAudioCaptureUsageDescription": "Joko shares computer audio only when you enable audio in Remote Desktop."
    },
    "target": [
      "dmg",
      "zip"
    ]
  },
  "linux": {
    "icon": "icon-light.svg",
    "category": "Development",
    "executableName": "joko",
    "target": [
      "AppImage",
      "tar.gz"
    ]
  }
}
